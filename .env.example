# ==============================================================================
# IGREJA BIBLICA HERDEIROS DE DEUS - VARIAVEIS DE AMBIENTE
# ==============================================================================
# Copie este arquivo para ".env" antes de executar localmente:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (LibSQL / Turso - 100% Gratuito)
# ------------------------------------------------------------------------------
# Desenvolvimento Local (SQLite via LibSQL, zero instalacao externa):
DATABASE_URL="file:./data/herdeiros.db"
DATABASE_AUTH_TOKEN=""

# Producao Gratuita no Turso (https://turso.tech):
# DATABASE_URL="libsql://herdeiros-de-deus-seuusuario.turso.io"
# DATABASE_AUTH_TOKEN="seu_token_turso_aqui"

# ------------------------------------------------------------------------------
# 2. AUTENTICACAO & SEGURANCA (JWT em Cookie HttpOnly)
# ------------------------------------------------------------------------------
# Gere uma chave forte em producao (ex: openssl rand -base64 32)
JWT_SECRET="herdeiros-de-deus-dev-secret-troque-em-producao-2026"

# ------------------------------------------------------------------------------
# 3. INFORMACOES PUBLICAS DA IGREJA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CHURCH_NAME="Igreja Bíblica Herdeiros de Deus"
NEXT_PUBLIC_CHURCH_SHORT_NAME="Herdeiros de Deus"
NEXT_PUBLIC_CHURCH_EMAIL="contato@herdeirosdedeus.org"
NEXT_PUBLIC_CHURCH_WHATSAPP="5585999999999"
NEXT_PUBLIC_CHURCH_ADDRESS="Rua A, nº 90 - Conjunto Jaciara, Barra do Ceará, Fortaleza - CE, CEP 60330-820"

# ------------------------------------------------------------------------------
# 4. UPLOAD DE IMAGENS EM NUVEM (Opcional - Cloudinary Free Tier 25GB)
# ------------------------------------------------------------------------------
# Em desenvolvimento local, uploads sao salvos em /public/uploads automaticamente.
# Em producao (Vercel), preencha para armazenar fotos do feed/cursos na nuvem:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

